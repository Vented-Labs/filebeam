APP_NAME=Filebeam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SOCKET=/run/mysqld/mysqld.sock
# PostgreSQL backup tools use the same TLS settings as Laravel.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/private/postgresql-ca.pem
# DB_SSLCERT=/private/postgresql-client.pem
# DB_SSLKEY=/private/postgresql-client.key
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Comma-separated private disks defined in config/filesystems.php. The built-in
# transfers disk stores ciphertext under storage/app/transfers.
# Remove FILEBEAM_FILESYSTEMS to manage store definitions in Filament instead.
# Plan defaults and placement mode always remain editable in Filament.
FILEBEAM_FILESYSTEMS=transfers
QUEUE_CONNECTION=database
# Cron processes short batches of database jobs. Disable only when using a persistent worker.
FILEBEAM_CRON_QUEUE_ENABLED=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Set to tls for encrypted TCP. Leave unset when REDIS_HOST is a Unix socket path.
# REDIS_SCHEME=tls
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
# The installer uses the chosen database for both cache data and locks.
# REDIS_DB=0
# REDIS_CACHE_DB=0
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=cache
# REDIS_PREFIX=filebeam:

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional exact host for /{username} receiving pages. /u/{username} remains available.
FILEBEAM_USERNAME_DOMAIN=
FILEBEAM_NAME="${APP_NAME}"
FILEBEAM_LOGO_URL=
FILEBEAM_FAVICON_URL=
FILEBEAM_GITHUB_URL=https://github.com/Vented-Labs/filebeam
FILEBEAM_COPYRIGHT_HOLDER=Vented
FILEBEAM_COPYRIGHT_YEAR=2026
# Set either value to true or false to lock it from the environment. Leave unset to manage it in Admin.
# FILEBEAM_REGISTRATION_ENABLED=
# FILEBEAM_ANONYMOUS_UPLOADS_ENABLED=
# FILEBEAM_USERNAME_ROUTING_ENABLED=
# Opt in to automatic signed package updates during the daily scheduled check.
FILEBEAM_AUTO_UPDATES_ENABLED=false
FILEBEAM_DEFAULT_PLAN=default
# Maximum encrypted HTTP body, including the 16-byte tag (17..25000000 bytes).
CHUNK_MAX_SIZE=25000000
FILEBEAM_UPLOAD_CONCURRENCY=4
FILEBEAM_DOWNLOAD_CONCURRENCY=4
FILEBEAM_WRITES_PER_MINUTE=600
FILEBEAM_READS_PER_MINUTE=1200
# All storage request attempts/retries must finish before lease + cleanup grace.
FILEBEAM_UPLOAD_ATTEMPT_LEASE_SECONDS=900
FILEBEAM_UPLOAD_ATTEMPT_CLEANUP_GRACE_SECONDS=300
FILEBEAM_INCOMPLETE_EXPIRY_HOURS=2
FILEBEAM_DEFAULT_TRANSFER_BYTES=2147483648
FILEBEAM_DEFAULT_FILE_COUNT=20
FILEBEAM_DEFAULT_NOTE_BYTES=1048576
FILEBEAM_DEFAULT_FILE_RETENTION_HOURS=24
FILEBEAM_DEFAULT_NOTE_RETENTION_HOURS=720

# Sail overrides database/cache/queue connections inside its container only.
APP_PORT=8000
SAIL_APP_URL=http://localhost:8000
SAIL_DB_DATABASE=filebeam
SAIL_DB_USERNAME=sail
SAIL_DB_PASSWORD=password
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
VITE_PORT=5173
VITE_HMR_HOST=localhost
