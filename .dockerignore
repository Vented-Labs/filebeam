# Production builds use the repository root as their context. Start closed and
# admit only inputs needed to build the runtime image.
*

!.dockerignore
!docker/
!docker/production/
!docker/production/**
!docker/cli/
!docker/cli/**

!package.json
!package-lock.json
!vite.config.ts
!LICENSE
!SECURITY.md

!icons/
!icons/NOTICE
!icons/approved.json
!icons/dependency-inventory.json

!scripts/
!scripts/check-icons.mjs
!scripts/generate-icons.mjs
!scripts/og/
!scripts/og/**

!backend/
!backend/artisan
!backend/composer.json
!backend/composer.lock
!backend/package.json
!backend/vite.config.ts
!backend/tsconfig.json
!backend/app/
!backend/app/**
!backend/bootstrap/
!backend/bootstrap/*.php
!backend/config/
!backend/config/**
!backend/database/
!backend/database/migrations/
!backend/database/migrations/**
!backend/database/seeders/
!backend/database/seeders/**
!backend/database/factories/
!backend/database/factories/**
!backend/resources/
!backend/resources/**
!backend/routes/
!backend/routes/**
!backend/public/
!backend/public/index.php
!backend/public/frankenphp-worker.php
!backend/public/robots.txt
!backend/public/.htaccess
!backend/public/favicon.ico
!backend/public/favicon-*.png
!backend/public/apple-touch-icon.png
!backend/public/icon-*.png
!backend/public/brand/
!backend/public/brand/**
!backend/public/fonts/
!backend/public/fonts/**

!ui/
!ui/package.json
!ui/src/
!ui/src/**

!encryption/
!encryption/Cargo.toml
!encryption/Cargo.lock
!encryption/src/
!encryption/src/**

!update.php
!updater/
!updater/ActivityLock.php
!updater/PostgresBackup.php
!updater/Updater.php

# These denials are deliberately last: a future allowlist entry must not leak
# credentials, generated host state, or development tooling into an image.
.git
.git/**
**/.git
**/.git/**
**/.env
**/.env.*
**/node_modules
**/node_modules/**
**/vendor
**/vendor/**
**/pkg
**/pkg/**
**/target
**/target/**
**/public/build
**/public/build/**
**/public/hot
**/public/js
**/public/js/**
**/public/css/filament
**/public/css/filament/**
**/resources/js/actions
**/resources/js/actions/**
**/resources/js/routes
**/resources/js/routes/**
**/resources/js/wayfinder
**/resources/js/wayfinder/**
# Docker needs explicit backend paths to prune unreadable runtime directories
# before it walks them; the recursive rules above protect future locations.
backend/storage
backend/storage/**
/backend/storage/
/backend/storage/**
backend/bootstrap/cache
backend/bootstrap/cache/**
**/storage
**/storage/**
**/*.sqlite
**/*.sqlite-*
**/*.sql
**/*.dump
**/*.bak
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/.ai
**/.ai/**
**/.agents
**/.agents/**
**/.junie
**/.junie/**
**/.idea
**/.idea/**
**/.vscode
**/.vscode/**
**/.zed
**/.zed/**
dist
dist/**
test-results
test-results/**
playwright-report
playwright-report/**
tests
tests/**
mobile
mobile/**
