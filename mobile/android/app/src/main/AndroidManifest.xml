<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

    <application
        android:name=".FilebeamApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_filebeam"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Filebeam"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Verification stays off until a release signer and matching assetlinks.json are configured. -->
            <intent-filter android:autoVerify="${appLinkAutoVerify}">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appLinkHost}" />
            </intent-filter>
        </activity>
        <service android:name=".platform.background.TransferService"
            android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".platform.background.TransferJobService"
            android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" tools:targetApi="34" />
        <receiver android:name=".platform.background.TransferActionReceiver" android:exported="false" />
    </application>
</manifest>
