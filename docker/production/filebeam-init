#!/bin/sh
# shellcheck disable=SC2016
set -eu

data=${FILEBEAM_DATA_DIR:-/data}
tls=${FILEBEAM_TLS:-proxy}
name=${FILEBEAM_SERVER_NAME:-}
bootstrap=${FILEBEAM_BOOTSTRAP_ON_START:-false}

run_filebeam() {
    if [ "$(id -u)" = 0 ]; then
        setpriv --reuid=filebeam --regid=filebeam --init-groups -- "$@"
    else
        "$@"
    fi
}

validate_paths() {
    /usr/local/bin/php -r '
        foreach (array_slice($argv, 1) as $path) {
            if ($path === "" || $path[0] !== "/") {
                fwrite(STDERR, "Managed path must be absolute.\n");
                exit(1);
            }
            $current = "";
            foreach (explode("/", ltrim($path, "/")) as $component) {
                if ($component === "" || $component === "." || $component === "..") {
                    fwrite(STDERR, "Managed path contains an invalid component.\n");
                    exit(1);
                }
                $current .= "/" . $component;
                if (is_link($current)) {
                    fwrite(STDERR, "Managed path contains a symbolic link: " . $current . "\n");
                    exit(1);
                }
            }
        }
    ' "$@"
}

if [ -z "$name" ] && [ -n "${APP_URL:-}" ]; then
    name=$(/usr/local/bin/php -r 'echo parse_url($argv[1], PHP_URL_HOST) ?: "";' "$APP_URL")
fi
case "$bootstrap" in true|false) ;; *) printf '%s\n' 'FILEBEAM_BOOTSTRAP_ON_START must be true or false.' >&2; exit 64 ;; esac
case "$tls" in
    proxy) auto_https='    auto_https off'; redirect='' ;;
    auto|certificate)
        https_origin=$(/usr/local/bin/php -r '
            $host = $argv[1];
            $url = $argv[2] !== "" ? $argv[2] : "https://".$host;
            $parts = parse_url($url);
            $plainHost = trim($host, "[]");
            if ($host === "" || (! filter_var($plainHost, FILTER_VALIDATE_IP) && ! filter_var($plainHost, FILTER_VALIDATE_DOMAIN, FILTER_FLAG_HOSTNAME))
                || ! is_array($parts) || ($parts["scheme"] ?? null) !== "https"
                || strcasecmp($parts["host"] ?? "", $host) !== 0
                || isset($parts["user"]) || isset($parts["pass"]) || isset($parts["query"]) || isset($parts["fragment"])
                || (($parts["path"] ?? "/") !== "/")) {
                fwrite(STDERR, "Direct TLS requires a hostname and a matching root HTTPS APP_URL.\n");
                exit(64);
            }
            echo rtrim($url, "/");
        ' "$name" "${APP_URL:-}")
        auto_https='    auto_https disable_redirects'
        [ "$tls" = certificate ] && auto_https='    auto_https off'
        redirect="
http://:8080 {
    route {
        @health path /up
        handle @health {
            root * /opt/filebeam/backend/public
            import /run/filebeam/php-server.caddy
        }
        redir $https_origin{uri} 308
    }
}"
        ;;
    *) printf '%s\n' 'FILEBEAM_TLS must be proxy, auto, or certificate.' >&2; exit 64 ;;
esac
if [ "$tls" = certificate ]; then
    cert_file=${FILEBEAM_TLS_CERT_FILE:-}
    key_file=${FILEBEAM_TLS_KEY_FILE:-}
    validate_paths "$cert_file" "$key_file"
    if ! run_filebeam test -f "$cert_file" || ! run_filebeam test -r "$cert_file" || ! run_filebeam test -f "$key_file" || ! run_filebeam test -r "$key_file"; then
        printf '%s\n' 'Supplied TLS certificate and key must be regular files readable by Filebeam.' >&2
        exit 64
    fi
fi
validate_paths "$data/app/framework/cache/data" "$data/app/framework/sessions" "$data/app/framework/views" "$data/app/logs" "$data/config" "$data/database" "$data/caddy" /run/filebeam/cache /run/filebeam/views /tmp
if [ "${FILEBEAM_VARIANT:-light}" = omnibus ]; then
    validate_paths "$data/postgresql/18/docker" "$data/valkey" /run/filebeam/postgresql /run/filebeam/valkey
fi
mkdir -p "$data/app/framework/cache/data" "$data/app/framework/sessions" "$data/app/framework/views" "$data/app/logs" "$data/config" "$data/database" "$data/caddy" /run/filebeam/cache /run/filebeam/views /tmp
[ "$(id -u)" = 0 ] && chmod 1777 /tmp

if [ "$(id -u)" = 0 ]; then
    chown -h root:root /run/filebeam
    chmod 0755 /run/filebeam
    chown -h filebeam:filebeam "$data/app" "$data/app/framework" "$data/app/framework/cache" "$data/app/framework/cache/data" "$data/app/framework/sessions" "$data/app/framework/views" "$data/app/logs" "$data/config" "$data/database" "$data/caddy" /run/filebeam/cache /run/filebeam/views
    if mountpoint -q /storage; then validate_paths /storage; chown -h filebeam:filebeam /storage; fi
    if [ "${FILEBEAM_VARIANT:-light}" = omnibus ]; then
        mkdir -p "$data/postgresql/18/docker" "$data/valkey" /run/filebeam/postgresql /run/filebeam/valkey
        chown -h filebeampg:filebeampg "$data/postgresql" "$data/postgresql/18" "$data/postgresql/18/docker" /run/filebeam/postgresql
        chown -h filebeamvalkey:filebeamvalkey "$data/valkey" /run/filebeam/valkey
        chmod 0770 /run/filebeam/postgresql /run/filebeam/valkey
    fi
fi

if [ "$bootstrap" = true ]; then
    run_filebeam /usr/local/bin/php /opt/filebeam/backend/artisan filebeam:installation:bootstrap --no-interaction
fi

site="https://$name:8443"
[ "$tls" = proxy ] && site=':8080'
# Setup uses ordinary request PHP. The supervisor swaps this fragment for the
# persistent Octane worker only after the installer has completed.
validate_paths /run/filebeam/php-server.caddy /run/filebeam/worker.caddy /run/filebeam/tls.caddy /run/filebeam/Caddyfile
printf '%s\n' 'php_server' >/run/filebeam/php-server.caddy
printf '%s\n' '# Workers start after installation.' >/run/filebeam/worker.caddy
if [ "$tls" = certificate ]; then
    printf '%s\n' 'tls "{$FILEBEAM_TLS_CERT_FILE}" "{$FILEBEAM_TLS_KEY_FILE}"' >/run/filebeam/tls.caddy
else
    printf '%s\n' '# TLS certificates are managed by Caddy when enabled.' >/run/filebeam/tls.caddy
fi
export FILEBEAM_AUTO_HTTPS="$auto_https" FILEBEAM_HTTP_REDIRECT="$redirect" FILEBEAM_SITE="$site" FILEBEAM_CADDY_STORAGE="$data/caddy"
cp /etc/filebeam/Caddyfile /run/filebeam/Caddyfile
/usr/local/bin/frankenphp fmt --overwrite /run/filebeam/Caddyfile
exec "$@"
